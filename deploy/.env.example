# ─── VPS Hosts ───────────────────────────────────────────
STAGING_HOST=stage.mg-encounter.com
PRODUCTION_HOST=mg-encounter.com
SSH_USER=jkanimea
SSH_KEY=~/.ssh/id_ed25519

# ─── Database ────────────────────────────────────────────
SA_PASSWORD=YourStrong@Passw0rd
MSSQL_PID=Express

# ─── JWT ─────────────────────────────────────────────────
# Generate: openssl genrsa 2048 | base64 -w0
JWT_RSA_PRIVATE_KEY=

# ─── AI Features ─────────────────────────────────────────
# Required for AI Summarize (journal notes). Get key from https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ─── OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Container Registry (GHCR) ──────────────────────────
# For local deploys: set GHCR_TOKEN or push skipped (image stays local)
# In CI/CD: GITHUB_TOKEN is used automatically
GHCR_USER=
GHCR_TOKEN=

# ─── SSL ─────────────────────────────────────────────────
CERTBOT_EMAIL=admin@mg-encounter.com
