# ─── VPS Hosts ───────────────────────────────────────────
STAGING_HOST=staging.your-dns-name.com
PRODUCTION_HOST=your-dns-name.com
STAGING_SSH_USER=deploy
PRODUCTION_SSH_USER=deploy
SSH_KEY=~/.ssh/id_ed25519

# ─── Database ────────────────────────────────────────────
SA_PASSWORD=YourStrong@Passw0rd
MSSQL_PID=Express

# ─── JWT ─────────────────────────────────────────────────
# Generate: openssl genrsa 2048 | base64 -w0
JWT_RSA_PRIVATE_KEY=

# ─── AI Features ─────────────────────────────────────────
# Required for AI Summarize (journal notes). Get key from https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ─── OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── SSL ─────────────────────────────────────────────────
CERTBOT_EMAIL=admin@your-dns-name.com
